  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  errorMessage String?

  schedule ReportSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, startedAt(sort: Desc)])
  @@index([status])
  @@index([orgId])
}

