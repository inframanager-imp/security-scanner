  sections   String[] // SUMMARY | CONFIG_CHANGES | DRIFT | COMPLIANCE | POSTURE | IAM_ESCALATION
  recipients String[]
  isActive   Boolean   @default(true)
  lastRunAt  DateTime?
  nextRunAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  runs ReportRun[]

  @@index([isActive, nextRunAt])
