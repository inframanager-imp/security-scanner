// ─── IAM Privilege Escalation Events ─────────────────────────────────────────

model IamEscalationEvent {
  id              String    @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  provider        String
  targetId        String
  changeId        String?
  escalationType  String // POLICY_ATTACH | INLINE_POLICY | ROOT_ACTIVITY | ROLE_CREATION | CREDENTIAL_CREATION | TRUST_POLICY | ACCESS_KEY | ADMIN_GROUP | PERMISSION_BOUNDARY_DELETE
  severity        String    @default("HIGH")
  actor           String?
  actorType       String?
  targetPrincipal String?
  resourceId      String?
  resourceType    String?
