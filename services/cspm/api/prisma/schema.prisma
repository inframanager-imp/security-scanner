generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

enum AuthMethod {
  ACCESS_KEY
  ASSUME_ROLE
}

enum AzureAuthMethod {
  SERVICE_PRINCIPAL
  MANAGED_IDENTITY
}

enum ScanStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  MONITORING
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum FindingStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  FALSE_POSITIVE
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  passwordHash       String
  /// Legacy global role. Kept for backward compatibility and as the role
  /// granted when a user is auto-provisioned into a tenant; the effective
  /// role for API access is TenantMembership.role for the active tenant.
  role               Role                @default(VIEWER)
  /// Platform operator: may create tenants and act inside any tenant.
  isSuperAdmin       Boolean             @default(false)
  /// Tenant selected at last login; used to pick the active tenant.
  lastTenantId       String?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  sessions           Session[]
  memberships        TenantMembership[]
  accounts           Account[]           @relation("CreatedBy")
  azureSubscriptions AzureSubscription[] @relation("AzureCreatedBy")
  gcpProjects        GcpProject[]        @relation("GcpCreatedBy")
  auditLogs          AuditLog[]
}

// ─── Multi-tenancy: customer organizations ───────────────────────────────────
// Every tenant-owned row carries `tenantId`; the Prisma tenant extension in
// config/database.ts injects it on create and filters it on every read/write
// from the request's tenant context (config/tenantContext.ts).

model Tenant {
  id          String   @id @default(uuid())
  /// URL/CLI-friendly unique handle, e.g. "acme"
  slug        String   @unique
  name        String
  isActive    Boolean  @default(true)
  /// Free-form settings (branding, feature flags, SSO config later)
  settings    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships TenantMembership[]

  @@index([isActive])
}

model TenantMembership {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  role      Role     @default(VIEWER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id           String   @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  name         String
  awsAccountId String
  description  String?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Inventory pipeline state
  inventoryStatus  InventoryStatus @default(PENDING)
  inventoryInitAt  DateTime? // when READY was first reached
  lastDiscoveryAt  DateTime? // last successful discovery run
  lastConfigSyncAt DateTime? // last successful config change sync
  pipelineError    String? // last error message if FAILED

  createdBy         User                @relation("CreatedBy", fields: [createdById], references: [id])
  credential        AwsCredential?
  scans             Scan[]
  configChanges     ConfigChange[]
  resourceInventory ResourceInventory[]
  @@index([orgId])
}

model AwsCredential {
  id                       String     @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  accountId                String     @unique
  authMethod               AuthMethod
  encryptedAccessKeyId     String?
  encryptedSecretAccessKey String?
  roleArn                  String?
  externalId               String?
  defaultRegion            String     @default("us-east-1")
  additionalRegions        String[]
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
  account                  Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@index([orgId])
}

model Scan {
  id           String       @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  accountId    String
  status       ScanStatus   @default(QUEUED)
  triggeredBy  String?
  jobId        String?      @unique
  services     String[]
  regions      String[]
  startedAt    DateTime?
  completedAt  DateTime?
  durationMs   Int?
  errorMessage String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  summary      ScanSummary?
  findings     Finding[]
  @@index([orgId])
}

model ScanSummary {
  id       String @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  scanId   String @unique
  critical Int    @default(0)
  high     Int    @default(0)
  medium   Int    @default(0)
  low      Int    @default(0)
  info     Int    @default(0)
  total    Int    @default(0)
  scan     Scan   @relation(fields: [scanId], references: [id], onDelete: Cascade)
  @@index([orgId])
}

model Finding {
  id              String        @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  scanId          String
  service         String
  // Stable registry check ID (prowler-compatible), e.g. s3_bucket_default_encryption.
  // Nullable while scanners are migrated off hardcoded titles.
  checkId         String?
  severity        Severity
  title           String
  description     String        @db.Text
  evidence        Json
  remediation     String        @db.Text
  findingStatus   FindingStatus @default(OPEN)
  tags            String[]
  discoveredAt    DateTime
  // Phase 3 — risk prioritization
  riskScore       Int? // 0–100 composite (severity × reachability × business × exploit)
  reachability    String? // PUBLIC | INTERNAL | PRIVATE
  businessContext Json? // tag-derived: env, dataClass, owner, etc.
  exploitability  String? // KNOWN_EXPLOIT | POC | THEORETICAL
  enrichedAt      DateTime?
  createdAt       DateTime      @default(now())
  scan            Scan          @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([severity])
  @@index([service])
  @@index([checkId])
  @@index([findingStatus])
  @@index([riskScore(sort: Desc)])
  @@index([reachability])
  @@index([orgId])
}

// ─── Azure Models ──────────────────────────────────────────────────────────────

model AzureSubscription {
  id             String   @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  name           String
  subscriptionId String
  tenantId       String?
  description    String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Inventory pipeline state
  inventoryStatus  InventoryStatus @default(PENDING)
  inventoryInitAt  DateTime?
  lastDiscoveryAt  DateTime?
  lastConfigSyncAt DateTime?
  pipelineError    String?

  createdBy         User                @relation("AzureCreatedBy", fields: [createdById], references: [id])
  credential        AzureCredential?
  scans             AzureScan[]
  configChanges     ConfigChange[]
  resourceInventory ResourceInventory[]
  @@index([orgId])
}

model AzureCredential {
  id                    String            @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  subscriptionId        String            @unique
  authMethod            AzureAuthMethod
  encryptedTenantId     String?
  encryptedClientId     String?
  encryptedClientSecret String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  subscription          AzureSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  @@index([orgId])
}

model AzureScan {
  id             String            @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  subscriptionId String
  status         ScanStatus        @default(QUEUED)
  jobId          String?           @unique
  services       String[]
  startedAt      DateTime?
  completedAt    DateTime?
  durationMs     Int?
  errorMessage   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  subscription   AzureSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  summary        AzureScanSummary?
  findings       AzureFinding[]
  @@index([orgId])
}

model AzureScanSummary {
  id       String    @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  scanId   String    @unique
  critical Int       @default(0)
  high     Int       @default(0)
  medium   Int       @default(0)
  low      Int       @default(0)
  info     Int       @default(0)
  total    Int       @default(0)
  scan     AzureScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  @@index([orgId])
}

model AzureFinding {
  id              String        @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  scanId          String
  service         String
  severity        Severity
  title           String
  description     String        @db.Text
  evidence        Json
  remediation     String        @db.Text
  findingStatus   FindingStatus @default(OPEN)
  tags            String[]
  resourceGroup   String?
  resourceId      String?
  discoveredAt    DateTime
  // Phase 3 — risk prioritization
  riskScore       Int?
  reachability    String?
  businessContext Json?
  exploitability  String?
  enrichedAt      DateTime?
  createdAt       DateTime      @default(now())
  scan            AzureScan     @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([severity])
  @@index([service])
  @@index([findingStatus])
  @@index([riskScore(sort: Desc)])
  @@index([reachability])
  @@index([orgId])
}

// ─── Config Change Tracking ────────────────────────────────────────────────────

enum InventoryStatus {
  PENDING // no credentials yet, discovery not started
  INITIALIZING // first discovery + config sync running
  READY // initialized, real-time monitoring active
  FAILED // initialization failed
}

enum ChangeCategory {
  IAM
  NETWORK
  STORAGE
  COMPUTE
  DATABASE
  ENCRYPTION
  LOGGING
  OTHER
}

enum ChangeStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  FALSE_POSITIVE
}

model ConfigChange {
  id String @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension

  // exactly one of these will be set
  awsAccountId String?
  azureSubId   String?
  gcpProjectId String?

  provider  String // AWS | AZURE | GCP
  category  ChangeCategory @default(OTHER)
  riskScore Int            @default(20)
  severity  Severity       @default(LOW)

  sourceEventId String // CloudTrail eventID / Azure eventDataId / GCP insertId
  eventName     String
  eventTime     DateTime

  region    String?
  actor     String?
  actorType String?
  sourceIp  String?

  resourceType String?
  resourceId   String?
  resourceName String?

  summary       String @db.Text
  changeAction  String @default("MODIFIED") // CREATED | MODIFIED | DELETED
  previousValue Json?
  newValue      Json?

  changeStatus   ChangeStatus @default(OPEN)
  acknowledgedBy String?
  acknowledgedAt DateTime?
  notes          String?      @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  awsAccount Account?           @relation(fields: [awsAccountId], references: [id], onDelete: Cascade)
  azureSub   AzureSubscription? @relation(fields: [azureSubId], references: [id], onDelete: Cascade)
  gcpProject GcpProject?        @relation(fields: [gcpProjectId], references: [id], onDelete: Cascade)

  freezeViolation Boolean @default(false) // true when change occurred during a freeze window

  alertLogs       AlertLog[]
  integrationLogs IntegrationLog[]
  iamEscalations  IamEscalationEvent[]

  @@unique([sourceEventId, provider])
  @@index([awsAccountId, eventTime(sort: Desc)])
  @@index([azureSubId, eventTime(sort: Desc)])
  @@index([gcpProjectId, eventTime(sort: Desc)])
  @@index([severity])
  @@index([category])
  @@index([changeStatus])
  @@index([freezeViolation])
  @@index([orgId])
}

model ConfigSyncRun {
  id            String     @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  provider      String // AWS | AZURE | GCP
  targetId      String // Account.id / AzureSubscription.id / GcpProject.id
  status        ScanStatus @default(QUEUED)
  windowStart   DateTime
  windowEnd     DateTime
  eventsFound   Int?
  changesStored Int?
  errorMessage  String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([provider, targetId, createdAt(sort: Desc)])
  @@index([orgId])
}

// ─── Resource Inventory ────────────────────────────────────────────────────────

enum ResourceState {
  ACTIVE
  DELETED
}

enum DependencyType {
  NETWORK
  IAM
  STORAGE
  COMPUTE
  DATABASE
  IDENTITY_ASSUME // principal A can assume role B (sts:AssumeRole / OIDC trust)
  IDENTITY_PERMITS // principal A has permissions over resource B
  INTERNET_EXPOSURE // resource A is exposed to the internet via B (IGW, public IP, public SG)
  ENCRYPTION_KEY // resource A is encrypted with KMS key B
  CONTAINS_DATA // resource A contains data classified by B (DSPM link)
  RUNS_ON // workload A runs on host/cluster B
  OTHER
}

enum ExposureType {
  PUBLIC_INTERNET
  VPN_ONLY
  PRIVATE
}

model ResourceInventory {
  id       String @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  provider String // AWS | AZURE | GCP

  // exactly one of these FKs is set
  awsAccountId String?
  azureSubId   String?
  gcpProjectId String?

  nativeId      String // ARN / Azure Resource ID / GCP resource name
  resourceType  String // e.g. AWS::EC2::Instance
  resourceName  String?
  region        String?
  resourceGroup String? // Azure only

  tags        Json?
  configState Json // full current config as returned by the cloud API

  state             ResourceState @default(ACTIVE)
  // Phase 6 — DSPM data sensitivity classification (NONE | LOW | MEDIUM | HIGH | CRITICAL)
  dataSensitivity   String?
  discoveredAt      DateTime      @default(now()) // when scanner first found this resource
  resourceCreatedAt DateTime? // when cloud actually created the resource (from API metadata)
  lastSeenAt        DateTime      @default(now())
  deletedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  awsAccount Account?           @relation(fields: [awsAccountId], references: [id], onDelete: Cascade)
  azureSub   AzureSubscription? @relation(fields: [azureSubId], references: [id], onDelete: Cascade)
  gcpProject GcpProject?        @relation(fields: [gcpProjectId], references: [id], onDelete: Cascade)

  snapshots           ResourceSnapshot[]
  depsFrom            ResourceDependency[]    @relation("DepFrom")
  depsTo              ResourceDependency[]    @relation("DepTo")
  exposurePaths       ExposurePath[]
  workloadVulns       WorkloadVulnerability[]
  dataClassifications DataClassification[]

  @@unique([nativeId, provider])
  @@index([awsAccountId, resourceType])
  @@index([azureSubId, resourceType])
  @@index([gcpProjectId, resourceType])
  @@index([provider, state])
  @@index([resourceType])
  @@index([lastSeenAt(sort: Desc)])
  @@index([orgId])
}

model ResourceSnapshot {
  id          String   @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  inventoryId String
  configState Json
  changeType  String // CREATED | MODIFIED | DELETED
  capturedAt  DateTime
  createdAt   DateTime @default(now())

  inventory ResourceInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId, capturedAt(sort: Desc)])
  @@index([orgId])
}

model ResourceDependency {
  id            String         @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  fromId        String
  toId          String
  depType       DependencyType @default(OTHER)
  description   String?
  provider      String
  // Optional context for identity/permission edges
  principalArn  String? // cross-account or non-inventory principal ARN, when present
  principalType String? // USER | ROLE | GROUP | SERVICE | EXTERNAL_ACCOUNT
  actions       String[]       @default([]) // for IDENTITY_PERMITS: which actions are allowed
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  fromResource ResourceInventory @relation("DepFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toResource   ResourceInventory @relation("DepTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, depType])
  @@index([fromId])
  @@index([toId])
  @@index([depType, provider])
  @@index([orgId])
}

model ExposurePath {
  id                  String       @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  resourceInventoryId String
  provider            String
  exposureType        ExposureType
  pathJson            Json // ordered list of {resourceId, resourceType, edgeType, detail}
  entryPoint          String? // e.g. "0.0.0.0/0", "alb-arn", "cloudfront-distribution-id"
  computedAt          DateTime     @default(now())
  expiresAt           DateTime?
  updatedAt           DateTime     @updatedAt

  resource ResourceInventory @relation(fields: [resourceInventoryId], references: [id], onDelete: Cascade)

  @@unique([resourceInventoryId, exposureType])
  @@index([provider, exposureType])
  @@index([computedAt(sort: Desc)])
  @@index([orgId])
}

// ─── GCP Models ────────────────────────────────────────────────────────────────

enum GcpAuthMethod {
  SERVICE_ACCOUNT_KEY
  WORKLOAD_IDENTITY
}

model GcpProject {
  id          String   @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  name        String
  projectId   String   @unique
  description String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Inventory pipeline state
  inventoryStatus  InventoryStatus @default(PENDING)
  inventoryInitAt  DateTime?
  lastDiscoveryAt  DateTime?
  lastConfigSyncAt DateTime?
  pipelineError    String?

  createdBy         User                @relation("GcpCreatedBy", fields: [createdById], references: [id])
  credential        GcpCredential?
  scans             GcpScan[]
  configChanges     ConfigChange[]
  resourceInventory ResourceInventory[]
  @@index([orgId])
}

model GcpCredential {
  id                         String        @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  projectId                  String        @unique
  authMethod                 GcpAuthMethod
  encryptedServiceAccountKey String?
  serviceAccountEmail        String?
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
  project                    GcpProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([orgId])
}

model GcpScan {
  id           String          @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  projectId    String
  status       ScanStatus      @default(QUEUED)
  jobId        String?         @unique
  services     String[]
  startedAt    DateTime?
  completedAt  DateTime?
  durationMs   Int?
  errorMessage String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  project      GcpProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  summary      GcpScanSummary?
  findings     GcpFinding[]
  @@index([orgId])
}

model GcpScanSummary {
  id       String  @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  scanId   String  @unique
  critical Int     @default(0)
  high     Int     @default(0)
  medium   Int     @default(0)
  low      Int     @default(0)
  info     Int     @default(0)
  total    Int     @default(0)
  scan     GcpScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  @@index([orgId])
}

model GcpFinding {
  id              String        @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  scanId          String
  service         String
  severity        Severity
  title           String
  description     String        @db.Text
  evidence        Json
  remediation     String        @db.Text
  findingStatus   FindingStatus @default(OPEN)
  tags            String[]
  resourceName    String?
  region          String?
  discoveredAt    DateTime
  // Phase 3 — risk prioritization
  riskScore       Int?
  reachability    String?
  businessContext Json?
  exploitability  String?
  enrichedAt      DateTime?
  createdAt       DateTime      @default(now())
  scan            GcpScan       @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([severity])
  @@index([service])
  @@index([findingStatus])
  @@index([orgId])
}

// ─── Alerting ──────────────────────────────────────────────────────────────────

enum AlertChannel {
  SLACK
  EMAIL_SMTP
  EMAIL_O365
  EMAIL_GMAIL
}

model AlertConfig {
  id       String  @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  name     String
  isActive Boolean @default(true)

  minSeverity  String   @default("HIGH")
  categories   String[]
  providers    String[]
  targetIds    String[]
  onFreezeOnly Boolean  @default(false)

  channel         AlertChannel
  encryptedConfig String

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  logs      AlertLog[]
  @@index([orgId])
}

model AlertLog {
  id           String   @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  configId     String
  changeId     String?
  subject      String?
  status       String
  errorMessage String?
  sentAt       DateTime @default(now())

  config AlertConfig   @relation(fields: [configId], references: [id], onDelete: Cascade)
  change ConfigChange? @relation(fields: [changeId], references: [id], onDelete: SetNull)

  @@index([configId, sentAt(sort: Desc)])
  @@index([status])
  @@index([orgId])
}

// ─── Change Freeze Windows ────────────────────────────────────────────────────

model FreezeWindow {
  id          String    @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  name        String
  description String?
  providers   String[]
  targetIds   String[]
  daysOfWeek  Int[]
  startTime   String
  endTime     String
  timezone    String    @default("UTC")
  fixedStart  DateTime?
  fixedEnd    DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive])
  @@index([orgId])
}

// ─── Risk Posture Score ───────────────────────────────────────────────────────

model PostureScore {
  id               String   @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  provider         String
  targetId         String
  score            Int
  grade            String
  criticalOpen     Int      @default(0)
  highOpen         Int      @default(0)
  mediumOpen       Int      @default(0)
  lowOpen          Int      @default(0)
  freezeViolations Int      @default(0)
  calculatedAt     DateTime @default(now())

  @@index([provider, targetId, calculatedAt(sort: Desc)])
  @@index([orgId])
}

// ─── Baseline & Drift Detection ───────────────────────────────────────────────

model ConfigBaseline {
  id             String   @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  provider       String
  targetId       String
  name           String
  description    String?
  resourceCount  Int      @default(0)
  isActive       Boolean  @default(true)
  capturedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  currentVersion Int      @default(1)
  // Scope (BCDD-F06): persisted so refresh/drift-detect reapply the SAME
  // scope the baseline was captured with, instead of silently reverting to
  // "whole account" on the next refresh.
  resourceTypes  String[] @default([])
  nameSearch     String?
  region         String?

  snapshots    BaselineSnapshot[]
  driftResults DriftResult[]
  versions     BaselineVersion[]

  @@index([provider, targetId])
  @@index([isActive])
  @@index([orgId])
}

model BaselineSnapshot {
  id           String   @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  baselineId   String
  nativeId     String
  resourceType String
  resourceName String?
  region       String?
  configState  Json
  capturedAt   DateTime @default(now())

  baseline ConfigBaseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)

  @@index([baselineId])
  @@index([nativeId])
  @@index([orgId])
}

model DriftResult {
  id              String    @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  baselineId      String
  firstDetectedAt DateTime  @default(now()) // never changes — set on first detection
  detectedAt      DateTime  @default(now()) // updated on every re-scan
  nativeId        String
  resourceType    String
  resourceName    String?
  region          String?
  driftType       String // MODIFIED | ADDED | DELETED
  severity        String    @default("MEDIUM")
  // controlDomain (BCDD-F03): IAM | NETWORK | DATA_PROTECTION | LOGGING_MONITORING | WORKLOAD_HARDENING | OTHER
  controlDomain   String    @default("OTHER")
  driftedFields   Json?
  baselineConfig  Json?
  currentConfig   Json?
  lastSeenAt      DateTime? // for DELETED: last time resource was in inventory
  // status: OPEN | ACKNOWLEDGED | RESOLVED | REVERTED | SUPPRESSED | CLOSED
  status          String    @default("OPEN")
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  // Suppression (BCDD-F16): mandatory justification + expiry so accepted risks
  // don't recur as noise, but automatically re-open once the exception lapses.
  suppressedAt          DateTime?
  suppressedBy          String?
  suppressionReason     String?
  suppressionExpiresAt  DateTime?
  closedAt        DateTime?

  baseline ConfigBaseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)

  @@index([baselineId, detectedAt(sort: Desc)])
  @@index([status])
  @@index([driftType])
  @@index([severity])
  @@index([controlDomain])
  @@index([orgId])
}

// ─── Remediation Audit Trail (BCDD-F25) ────────────────────────────────────────
// Every remediation action — manual, guided, or automated — logged with actor,
// before/after state, and outcome. Distinct from DriftResult's own status/
// timestamp fields: those record *what state a finding is in*, this records
// *what action was taken and by whom*, immutably (rows are never updated).

model RemediationLog {
  id            String   @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  driftResultId String
  baselineId    String
  // action: AUTO_REVERT | MANUAL_RESOLVE | GUIDED_PLAN_GENERATED
  action        String
  actor         String
  // outcome: SUCCESS | FAILURE
  outcome       String
  message       String?  @db.Text
  beforeState   Json?
  afterState    Json?
  createdAt     DateTime @default(now())

  @@index([driftResultId, createdAt(sort: Desc)])
  @@index([baselineId, createdAt(sort: Desc)])
  @@index([orgId])
}

// ─── Baseline Version History ─────────────────────────────────────────────────

model BaselineVersion {
  id            String   @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  baselineId    String
  versionNumber Int
  label         String? // e.g. "v3 — Refreshed 2025-04-04 by admin@co.com"
  resourceCount Int      @default(0)
  capturedAt    DateTime @default(now())
  capturedBy    String? // email of requester

  baseline  ConfigBaseline            @relation(fields: [baselineId], references: [id], onDelete: Cascade)
  snapshots BaselineVersionSnapshot[]

  @@unique([baselineId, versionNumber])
  @@index([baselineId, capturedAt(sort: Desc)])
  @@index([orgId])
}

model BaselineVersionSnapshot {
  id           String  @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  versionId    String
  nativeId     String
  resourceType String
  resourceName String?
  region       String?
  configState  Json

  version BaselineVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@index([nativeId])
  @@index([orgId])
}

// ─── Approval Workflow ─────────────────────────────────────────────────────────

model ApprovalRequest {
  id              String    @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  action          String // CAPTURE | REFRESH | REVERT
  baselineId      String? // target baseline
  driftId         String? // for REVERT actions
  requestedBy     String // email
  requestedByName String?
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED | EXPIRED | CANCELLED | EXECUTING | COMPLETED | FAILED
  notes           String? // requester notes
  reviewedBy      String? // email of approver
  reviewedByName  String?
  reviewNotes     String? // approver notes
  requestedAt     DateTime  @default(now())
  reviewedAt      DateTime?
  expiresAt       DateTime // auto-expire after 24h
  executedAt      DateTime?
  executionError  String?
  metadata        Json? // stores params needed to execute the approved action

  @@index([status])
  @@index([baselineId])
  @@index([requestedAt(sort: Desc)])
  @@index([orgId])
}

