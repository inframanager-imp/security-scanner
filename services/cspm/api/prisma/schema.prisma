  change ConfigChange? @relation(fields: [changeId], references: [id], onDelete: SetNull)

  @@index([provider, targetId, eventTime(sort: Desc)])
  @@index([escalationType])
  @@index([status])
  @@index([severity])
  @@index([orgId])
}

// ─── Compliance Evidence (auto-collected + manual) ────────────────────────────

model ComplianceEvidence {
  id                  String    @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  frameworkId         String // NIST_800_53 | GDPR | FEDRAMP | PCI_DSS | etc.
  controlId           String // e.g. AC-2, GDPR-Art32
  provider            String // AWS | AZURE | GCP
  accountId           String? // cloud account / subscription / project id (internal)
  evidenceType        String // AUTO_FINDING | AUTO_SCAN | MANUAL
  status              String // COMPLIANT | NON_COMPLIANT | INSUFFICIENT
  summary             String    @db.Text
  detail              Json?
  sourceType          String? // Finding | Scan | ConfigChange
  sourceId            String?
  // Phase 4 — per-control evidence package
  evaluatedResources  Json? // [{ resourceId, nativeId, resourceType, passed }]
  passingCount        Int       @default(0)
  failingCount        Int       @default(0)
  snapshotConfigState Json? // sampled configState slice relevant to the control
  nextEvaluationAt    DateTime?
  collectedAt         DateTime  @default(now())
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([frameworkId, controlId, provider, accountId, evidenceType])
  @@index([frameworkId, controlId])
  @@index([provider, accountId])
  @@index([collectedAt(sort: Desc)])
  @@index([status])
  @@index([nextEvaluationAt])
  @@index([orgId])
}

// ─── Risk Register ────────────────────────────────────────────────────────────

model RiskItem {
  id                  String    @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  title               String
  description         String    @db.Text
  category            String // CONFIGURATION | VULNERABILITY | ACCESS | COMPLIANCE | OPERATIONAL | DATA
  likelihood          Int // 1-5
  impact              Int // 1-5
  riskScore           Int // likelihood * impact  (1-25)
  status              String    @default("OPEN") // OPEN | ACCEPTED | MITIGATED | CLOSED
  owner               String?
  dueDate             DateTime?
  provider            String? // AWS | AZURE | GCP
  accountId           String?
  linkedFindingIds    Json      @default("[]")
  linkedControlIds    Json      @default("[]")
  mitigationPlan      String?   @db.Text
  acceptanceRationale String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status])
  @@index([riskScore(sort: Desc)])
  @@index([provider, accountId])
  @@index([category])
  @@index([orgId])
}

// ─── ML Anomaly Detection ─────────────────────────────────────────────────────

model AnomalyBaseline {
  id             String   @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  provider       String // AWS | AZURE | GCP
  accountId      String // internal account/subscription/project id
  actorId        String // IAM user / service principal / service account / "account"
  metricKey      String // e.g. "api_calls_per_hour" | "unique_ips_per_day" | "error_rate"
  // EWMA state
  ewmaMean       Float    @default(0)
  ewmaVariance   Float    @default(0)
  sampleCount    Int      @default(0)
  lastValue      Float    @default(0)
  lastUpdated    DateTime @default(now())
  // Geo/IP knowledge
  knownIps       Json     @default("[]") // up to 50 known IPs
  knownCountries Json     @default("[]") // known country codes
  knownRegions   Json     @default("[]") // known AWS regions / Azure regions
  // Temporal pattern (hourly buckets 0-23)
  hourlyActivity Json     @default("{}") // { "0": count, "1": count, ... }
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([provider, accountId, actorId, metricKey])
  @@index([provider, accountId])
  @@index([actorId])
  @@index([orgId])
}

model AnomalyEvent {
  id              String    @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  provider        String // AWS | AZURE | GCP
  accountId       String
  actorId         String
  anomalyType     String // FREQUENCY | GEOGRAPHIC | TEMPORAL | ACCESS_DENIED | IMPOSSIBLE_TRAVEL | RARE_EVENT | LATERAL_MOVEMENT | DATA_EXFIL
  severity        String // LOW | MEDIUM | HIGH | CRITICAL
  score           Float // anomaly score 0–100
  description     String    @db.Text
  detail          Json // raw feature values + baseline comparison
  sourceIp        String?
  country         String?
  eventName       String?
  relatedEventIds Json      @default("[]")
  status          String    @default("OPEN") // OPEN | ACKNOWLEDGED | RESOLVED | FALSE_POSITIVE
  resolvedAt      DateTime?
  notes           String?   @db.Text
  detectedAt      DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([provider, accountId, detectedAt(sort: Desc)])
  @@index([anomalyType])
  @@index([severity])
  @@index([status])
  @@index([actorId])
  @@index([orgId])
}

// ─── CIEM: Principal Permissions & Attack Paths ───────────────────────────────

model PrincipalPermission {
  id             String   @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  provider       String // AWS | AZURE | GCP
  accountId      String // internal AwsAccount / AzureSubscription / GcpProject id
  principalArn   String
  principalType  String // USER | ROLE | GROUP | SERVICE | SERVICE_PRINCIPAL | SERVICE_ACCOUNT
  action         String // e.g. "iam:PassRole" | "*" | "storage.objects.get"
  resourceArn    String // resource the action targets (ARN / Azure ID / GCP name), "*" allowed
  effect         String // ALLOW | DENY
  conditionsJson Json?
  source         String // DIRECT | GROUP | ROLE_CHAIN | INLINE | MANAGED
  flattenedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([provider, accountId, principalArn, action, resourceArn, effect, source])
  @@index([provider, accountId, principalArn])
  @@index([action])
  @@index([resourceArn])
  @@index([orgId])
}

model AttackPath {
  id             String    @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  provider       String
  accountId      String
  kind           String // PRIVILEGE_ESCALATION | LATERAL_MOVEMENT | EXTERNAL_TO_ADMIN | DATA_EXFILTRATION
  severity       String // CRITICAL | HIGH | MEDIUM | LOW
  sourceNodeId   String? // ResourceInventory.id or principal ARN
  sourceLabel    String // human-readable
  sinkNodeId     String?
  sinkLabel      String
  pathJson       Json // ordered hops: [{ nodeId, label, edgeType, detail }]
  summary        String    @db.Text
  status         String    @default("OPEN") // OPEN | ACKNOWLEDGED | RESOLVED | FALSE_POSITIVE
  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  notes          String?   @db.Text
  fingerprint    String // hash of source+sink+kind for dedup
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([provider, accountId, fingerprint])
  @@index([provider, accountId, severity])
  @@index([kind])
  @@index([status])
  @@index([lastSeenAt(sort: Desc)])
  @@index([orgId])
}

// ─── CWPP: Workload Vulnerabilities ───────────────────────────────────────────

model WorkloadVulnerability {
  id                  String    @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  provider            String
  accountId           String
  resourceInventoryId String
  packageName         String
  packageVersion      String
  cveId               String
  severity            String // CRITICAL | HIGH | MEDIUM | LOW | UNKNOWN
  cvssScore           Float?
  fixedVersion        String?
  exploitAvailable    Boolean   @default(false)
  summary             String?   @db.Text
  reference           String?
  sourceFeed          String // SSM_INVENTORY | INSPECTOR | AZURE_DEFENDER | GCP_OSCONFIG | OSV
  observedAt          DateTime  @default(now())
  status              String    @default("OPEN") // OPEN | FIXED | SUPPRESSED
  suppressedReason    String?
  resolvedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  resource ResourceInventory @relation(fields: [resourceInventoryId], references: [id], onDelete: Cascade)

  @@unique([resourceInventoryId, cveId, packageName])
  @@index([provider, accountId, severity])
  @@index([cveId])
  @@index([status])
  @@index([observedAt(sort: Desc)])
  @@index([orgId])
}

// ─── DSPM: Data Classification ────────────────────────────────────────────────

model DataClassification {
  id                  String    @id @default(uuid())
  orgId String  @default("") /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  provider            String
  accountId           String
  resourceInventoryId String
  dataType            String // PII | PHI | PCI | SECRETS | FINANCIAL | IP
  confidence          String // HIGH | MEDIUM | LOW
  sampleCount         Int       @default(0)
  totalObjectsSampled Int       @default(0)
  evidence            Json // { regexHits: [...], samplePaths: [...], classifierVersion }
  classifiedAt        DateTime  @default(now())
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  resource ResourceInventory @relation(fields: [resourceInventoryId], references: [id], onDelete: Cascade)

  @@unique([resourceInventoryId, dataType])
  @@index([provider, accountId, dataType])
  @@index([confidence])
  @@index([classifiedAt(sort: Desc)])
  @@index([orgId])
}

// ─── Audit log: user-action trail (see middleware/auditLog.ts) ─────────────────

model AuditLog {
  id          String   @id @default(uuid())
  orgId String?      /// Tenant.id (organization); injected + enforced by the Prisma tenant extension
  createdAt   DateTime @default(now())
  userId      String?
  userRole    String?
  actorEmail  String? // login attempts: email supplied, before a user is resolved
  action      String // "accounts.create", "approvals.approve", "auth.login" ...
  method      String
  path        String
  query       String?
  statusCode  Int
  outcome     String // SUCCESS | FAILED | DENIED
  ip          String?
  userAgent   String?
  requestBody String? // JSON, secrets redacted, truncated
  durationMs  Int?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([action])
  @@index([outcome])
  @@index([orgId])
}
