# ── CSPM Web (React + Vite, served by nginx) ──────────────────────────────────
# Build context: aws-scanner root (only the web/ workspace is used).
FROM node:20-bookworm-slim AS build

WORKDIR /app/web
COPY web/package.json ./
RUN npm install --no-audit --no-fund

COPY web/ ./
# Use vite build directly (the package script runs `tsc && vite build`; skipping
# tsc keeps the image build from failing on non-blocking type errors).
RUN npx vite build

# ── Runtime: nginx serves the static bundle and reverse-proxies the API ────────
FROM nginx:1.27-alpine
COPY docker/web-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/web/dist /usr/share/nginx/html
EXPOSE 80
