{
  "name": "aws-scanner",
  "version": "1.0.0",
  "description": "AWS Vulnerability & Security Compliance Scanner",
  "main": "dist/index.js",
  "bin": {
    "aws-scanner": "dist/cli/index.js"
  },
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "build": "node --max-old-space-size=5120 node_modules/typescript/bin/tsc",
    "typecheck": "npm run typecheck:aws && npm run typecheck:azure && npm run typecheck:gcp",
    "typecheck:aws": "node --max-old-space-size=3072 node_modules/typescript/bin/tsc -p tsconfig.aws.json",
    "typecheck:azure": "node --max-old-space-size=2048 node_modules/typescript/bin/tsc -p tsconfig.azure.json",
    "typecheck:gcp": "node --max-old-space-size=3072 node_modules/typescript/bin/tsc -p tsconfig.gcp.json",
    "dev": "ts-node src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rm -rf dist coverage",
    "ui:dev": "concurrently \"npm run dev --workspace=api\" \"npm run dev --workspace=web\"",
    "ui:build": "npm run build --workspace=api && npm run build --workspace=web",
    "db:migrate": "npm run db:migrate --workspace=api",
    "db:studio": "npm run db:studio --workspace=api"
  },
  "keywords": [
    "aws",
    "security",
    "vulnerability",
    "scanner",
    "compliance"
  ],
  "author": "Your Organization",
  "license": "MIT",
