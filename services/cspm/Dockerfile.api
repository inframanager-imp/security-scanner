# ── CSPM API (Express + Prisma + BullMQ workers + Socket.IO) ──────────────────
# Build context MUST be the aws-scanner root: the API imports the scanner engine
# from the root  src/  via  ../../../src/...  and runs the BullMQ workers in-process.
FROM node:20-bookworm-slim

WORKDIR /app

# OpenSSL + CA certs are required by Prisma's query engine. The rest are
# Chromium's runtime deps for Puppeteer (server-side "Compile PDF Report" —
# renders the executive report HTML to a real PDF via headless Chrome).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      openssl ca-certificates \
      chromium \
      libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libxkbcommon0 \
      libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 libasound2 \
      libpango-1.0-0 libpangocairo-1.0-0 fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# Skip Puppeteer's own Chromium download — use the apt package above instead
# (smaller image, no duplicate download of the same binary).
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Install dependencies. npm workspaces needs every workspace package.json present.
COPY package.json ./
COPY api/package.json ./api/
RUN npm install --no-audit --no-fund

# Application source (root scanner engine + the API).
COPY tsconfig.json ./
COPY src ./src
COPY api ./api

# Generate the Prisma client against the API schema.
RUN npx prisma generate --schema=api/prisma/schema.prisma

# Entrypoint runs DB migrations, then boots the server (server.ts also seeds the
# admin user and starts all workers). Run via ts-node transpile-only to avoid the
# cross-directory dist layout problem caused by the ../../../src import.
COPY docker/api-entrypoint.sh /usr/local/bin/api-entrypoint.sh
RUN chmod +x /usr/local/bin/api-entrypoint.sh

ENV NODE_ENV=production
EXPOSE 3001
ENTRYPOINT ["api-entrypoint.sh"]
