# Copy this file to `.env` (same directory as docker-compose.yml) and fill in
# real values. docker compose reads .env automatically for the ${VAR}
# substitutions used across all services. `.env` itself should stay gitignored.

# ── Shared auth secret ────────────────────────────────────────────────────────
# Must be IDENTICAL across cspm-api, aspm-api, and agent-api — cspm-api issues
# the JWT on login, the other two validate it. Generate real ones with:
#   openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# 64 hex chars — encrypts stored cloud credentials (AWS/Azure/GCP keys) at rest.
CREDENTIAL_ENCRYPTION_KEY=

# First-login admin account — only seeds the admin user when the users table
# is empty. Changing this after the account already exists does NOT rotate
# its password; use the account's own password-change flow instead.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ── Remote infra (postgres / redis / zap) ─────────────────────────────────────
# These now run on a separate VPS via docker-compose.remote.yml instead of as
# local containers. Point this app stack at that VPS here. Credentials must
# match what you set in the VPS's .env.remote.
#
#   DATABASE_URL      — used by cspm-api (schema=cspm)
#   ASPM_DATABASE_URL — used by aspm-api (psycopg driver, schema set separately)
#   REDIS_URL          — used by cspm-api
#   ZAP_PROXY / ZAP_API_KEY — used by aspm-api for DAST scans
DATABASE_URL=postgresql://scanner:CHANGE_ME@REMOTE_HOST:5434/vapt?schema=cspm
ASPM_DATABASE_URL=postgresql+psycopg://scanner:CHANGE_ME@REMOTE_HOST:5434/vapt
REDIS_URL=redis://:CHANGE_ME@REMOTE_HOST:6379
ZAP_PROXY=http://REMOTE_HOST:8090
ZAP_API_KEY=

# ── Agent API — LLM provider config ──────────────────────────────────────────
# One of: ollama (default, runs fully local — nothing leaves your machine),
# anthropic, openai
LLM_PROVIDER=ollama

# Model name — meaning depends on the provider above:
#   ollama:    a model you've pulled locally. qwen2.5-coder:7b (4.7GB, code-tuned)
#              is the default here; qwen2.5:latest is a general-purpose fallback;
#              qwen2.5-coder:14b needs ~9GB+ headroom at load time (OOM'd on an
#              11-12GB-class machine in testing).
#   anthropic: e.g. claude-sonnet-5
#   openai:    e.g. gpt-4.1-mini
AGENT_MODEL=qwen2.5-coder:7b

# Only used when LLM_PROVIDER=ollama. Can point at a remote VPS-hosted Ollama
# instance instead of a local daemon reached through host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Only used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Only used when LLM_PROVIDER=openai
OPENAI_API_KEY=

# Only used when LLM_PROVIDER=groq (or as a fallback candidate)
GROQ_API_KEY=
